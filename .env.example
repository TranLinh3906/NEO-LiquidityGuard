# Active read-only market-data provider
DATA_PROVIDER=SSI

# SSI FastConnect V3 production endpoints
SSI_API_URL=https://api.ssi.com.vn
SSI_STREAMING_URL=wss://stream.ssi.com.vn/ws/v3
# Optional custom trusted CA file. Blank uses certifi; TLS verification stays enabled.
SSI_CA_BUNDLE=

# Obtain from https://developers.ssi.com.vn
SSI_CLIENT_ID=YOUR_SSI_CLIENT_ID
SSI_API_KEY=YOUR_SSI_API_KEY
SSI_API_SECRET=YOUR_SSI_API_SECRET

# Market Data only. Do not add OTP, account number, or private key.
# WATCHLIST uses SSI_SYMBOLS; VN30 uses the reviewed built-in HOSE basket;
# ALL resolves every SSI-classified Stock from saved securitiesByBoard data.
# VN30 is the safe default. ALL can be large and must match SSI permissions.
SSI_COLLECTION_SCOPE=VN30
SSI_SYMBOLS=
SSI_UNIVERSE_RAW_ROOT=data/raw/rest
SSI_REQUEST_TIMEOUT=10
SSI_MAX_RETRIES=3
SSI_RETRY_DELAY=2
SSI_MAX_RPS=5
SSI_HEARTBEAT_INTERVAL=30
SSI_COLLECTOR_STATUS_PATH=data/runtime/collector_status.json

# Keep false until real SSI REST and quote-stream raw events exist.
SSI_DATA_MODE=SYNTHETIC_TEST
SSI_LIVE_CONFIRMED=false

# SSI quote-unit evidence (leave blank until SSI confirms the convention).
# Never assume 1000: the multiplier may be 1, 1000, or another documented value.
SSI_QUOTE_PRICE_MULTIPLIER_TO_VND=1
SSI_QUOTE_QUANTITY_MULTIPLIER_TO_SHARES=1
SSI_UNITS_EVIDENCE_REF=SSI_CUSTOMER_SUPPORT_EMAIL_QUOTE_UNITS_FULL_BOOK_2026-11-19
SSI_COMPLETE_BOOK_VERIFIED=true
